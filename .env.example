# Neon PostgreSQL Connection URL
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Authentication & JWT Secrets
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Real Email Configuration (Gmail / Yahoo / Outlook / Custom SMTP)
# Option A: Send via Google (Gmail)
SMTP_SERVICE="gmail"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"
EMAIL_FROM="EcoPartnerHub <your-email@gmail.com>"

# Option B: Send via Yahoo Mail
# SMTP_SERVICE="yahoo"
# SMTP_USER="your-email@yahoo.com"
# SMTP_PASS="your-yahoo-app-password"
# EMAIL_FROM="EcoPartnerHub <your-email@yahoo.com>"

# Option C: Custom SMTP (Brevo, SendGrid, Amazon SES, etc.)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="apikey_or_user@example.com"
# SMTP_PASS="your-smtp-password-or-api-key"
