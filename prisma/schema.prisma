// =============================================================
// EcoPartnerHub - Proposed Core Database Schema (Draft)
// Target Database Engine: PostgreSQL (Neon Serverless)
// ORM: Prisma ORM
// Draft File: prisma/schema.draft.prisma
// Note: Created for team review. Do not overwrite schema.prisma.
// =============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================
// ENUMS (6 Core Enums)
// =============================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ProviderVerificationStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

enum MembershipTier {
  FREE
  VERIFIED_STANDARD
  PREMIUM
  ENTERPRISE
}

enum MarketplaceType {
  REGIONAL
  INDUSTRY_VERTICAL
  GLOBAL
}

enum ListingStatus {
  ACTIVE
  PAUSED
  DRAFT
  ARCHIVED
}

enum PricingModel {
  FIXED
  HOURLY
  CUSTOM_QUOTE
  STARTING_AT
}

// =============================================================
// 1. IDENTITY & ACCESS CONTROL (Coordination: Akshay)
// =============================================================

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String?
  fullName        String
  phone           String?
  roleId          String
  status          UserStatus  @default(PENDING_VERIFICATION)
  isEmailVerified Boolean     @default(false)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  // Relations
  role                   Role                           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  customerProfile        CustomerProfile?
  providerProfile        ProviderProfile?               @relation("UserProviderProfile")
  auditedProfiles        ProviderProfile[]              @relation("AuditorRelation")
  verificationAuditLogs  ProviderVerificationAuditLog[]

  @@index([roleId])
  @@index([status])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  roles       RolePermission[]

  @@index([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())

  // Relations
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// =============================================================
// 2. PROFILES (Customer & Provider)
// =============================================================

model CustomerProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  companyName   String?
  contactPerson String?
  phone         String?
  industry      String?
  companySize   String?
  website       String?
  addressLine1  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  preferences   Json?    @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, country])
}

model ProviderProfile {
  id                 String                     @id @default(uuid())
  userId             String                     @unique
  businessName       String
  slug               String                     @unique
  legalEntityName    String?
  registrationNumber String?
  taxId              String?
  description        String
  tagline            String?
  logoUrl            String?
  bannerUrl          String?
  website            String?
  contactEmail       String
  contactPhone       String
  addressLine1       String?
  city               String
  state              String
  postalCode         String
  country            String
  latitude           Decimal?                   @db.Decimal(10, 7)
  longitude          Decimal?                   @db.Decimal(10, 7)
  verificationStatus ProviderVerificationStatus @default(DRAFT)
  verifiedAt         DateTime?
  verifiedBy         String?
  rejectionReason    String?
  isPubliclyVisible  Boolean                    @default(false)
  rating             Decimal                    @default(0.00) @db.Decimal(3, 2)
  reviewCount        Int                        @default(0)
  membershipTier     MembershipTier             @default(FREE)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  deletedAt          DateTime?

  // Relations
  user               User                           @relation("UserProviderProfile", fields: [userId], references: [id], onDelete: Cascade)
  auditor            User?                          @relation("AuditorRelation", fields: [verifiedBy], references: [id], onDelete: SetNull)
  services           ProviderService[]
  marketplaces       ProviderMarketplace[]
  verificationLogs   ProviderVerificationAuditLog[]

  // Composite Indexes for High-Performance Provider Discovery & Filtering
  @@index([verificationStatus, isPubliclyVisible, deletedAt, membershipTier, rating(sort: Desc)])
  @@index([latitude, longitude])
  @@index([city, state, country])
  @@index([verifiedBy])
}

// =============================================================
// 3. TAXONOMY: CATEGORIES & SERVICES
// =============================================================

model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String?
  iconUrl      String?
  parentId     String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[] @relation("CategoryHierarchy")
  services     Service[]

  // Composite Index for Hierarchical Category Lookups
  @@index([parentId, isActive, displayOrder])
  @@index([isActive, displayOrder])
}

model Service {
  id               String            @id @default(uuid())
  categoryId       String
  name             String
  slug             String            @unique
  shortDescription String?
  description      String
  iconUrl          String?
  isActive         Boolean           @default(true)
  displayOrder     Int               @default(0)
  metadata         Json?             @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providers        ProviderService[]

  @@index([categoryId])
  @@index([isActive, displayOrder])
}

// =============================================================
// 4. MARKETPLACE & PARTICIPATION
// =============================================================

model Marketplace {
  id          String                @id @default(uuid())
  name        String
  slug        String                @unique
  description String?
  type        MarketplaceType       @default(REGIONAL)
  regionCode  String?
  currency    String                @default("INR")
  isActive    Boolean               @default(true)
  config      Json?                 @default("{}")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  // Relations
  providers   ProviderMarketplace[]

  @@index([type, regionCode])
  @@index([isActive])
}

model ProviderService {
  id                String          @id @default(uuid())
  providerId        String
  serviceId         String
  customTitle       String?
  customDescription String?
  pricingModel      PricingModel    @default(CUSTOM_QUOTE)
  startingPrice     Decimal?        @db.Decimal(12, 2)
  currency          String?
  experienceYears   Int?
  status            ListingStatus   @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  provider          ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service           Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([providerId, serviceId])
  // Composite Indexes for Service Offering Discovery & Filtering
  @@index([serviceId, status])
  @@index([providerId, status])
}

model ProviderMarketplace {
  id              String          @id @default(uuid())
  providerId      String
  marketplaceId   String
  isListed        Boolean         @default(true)
  listingPriority Int             @default(0)
  joinedAt        DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  marketplace     Marketplace     @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)

  @@unique([providerId, marketplaceId])
  // Composite Index for Marketplace Provider Priority Directory Queries
  @@index([marketplaceId, isListed, listingPriority(sort: Desc)])
  @@index([providerId])
}

// =============================================================
// 5. AUDIT LOGGING & COMPLIANCE HISTORY (Coordination: Om Prakash)
// =============================================================

model ProviderVerificationAuditLog {
  id             String                     @id @default(uuid())
  providerId     String
  previousStatus ProviderVerificationStatus?
  newStatus      ProviderVerificationStatus
  action         String
  changedById    String
  reason         String?
  internalNotes  String?
  metadata       Json?                      @default("{}")
  createdAt      DateTime                   @default(now())

  // Relations
  provider       ProviderProfile            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  changedBy      User                       @relation(fields: [changedById], references: [id], onDelete: Restrict)

  // Compliance audit history indexes
  @@index([providerId, createdAt(sort: Desc)])
  @@index([changedById])
}
