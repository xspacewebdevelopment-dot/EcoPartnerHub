  "item": [
    {
      "name": "1. Customer Authentication",
      "item": [
        {
          "name": "1.1 Customer Registration [201 Created]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response returns valid user and JWT token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.user.role).to.eql(\"CUSTOMER\");",
                  "    pm.expect(jsonData.token).to.be.a(\"string\");",
                  "    if (jsonData.token) {",
                  "        pm.environment.set(\"customerToken\", jsonData.token);",
                  "        pm.environment.set(\"currentCustomerId\", jsonData.user.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ecocustomer_{{$timestamp}}@example.com\",\n  \"password\": \"SecureCustomer@2026!\",\n  \"phone\": \"+9191000{{$randomInt}}\",\n  \"fullName\": \"Rajesh Sharma\",\n  \"businessName\": \"EcoRetail Solutions\",\n  \"businessType\": \"E-commerce Retailer\",\n  \"city\": \"Bengaluru\",\n  \"marketplacePresence\": [\"Amazon India\", \"Flipkart\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/customer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", "customer"]
            }
          }
        },
